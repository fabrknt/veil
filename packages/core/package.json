{
  "name": "@fabrknt/veil-core",
  "version": "2.0.0",
  "description": "Privacy primitives you can take one at a time: NaCl box encryption, Shamir secret sharing, payload serialization and encrypted DEX orders (chain-agnostic), plus optional Solana extensions (ZK compression, shielded transfers, Arcium MPC, Noir proofs)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./box": {
      "types": "./dist/nacl-box.d.ts",
      "default": "./dist/nacl-box.js"
    },
    "./shamir": {
      "types": "./dist/threshold.d.ts",
      "default": "./dist/threshold.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "default": "./dist/payload.js"
    },
    "./orders": {
      "types": "./dist/orders.d.ts",
      "default": "./dist/orders.js"
    },
    "./solana/zk-compression": {
      "types": "./dist/zk-compression.d.ts",
      "default": "./dist/zk-compression.js"
    },
    "./solana/rpc-providers": {
      "types": "./dist/rpc-providers.d.ts",
      "default": "./dist/rpc-providers.js"
    },
    "./solana/shielded": {
      "types": "./dist/shielded.d.ts",
      "default": "./dist/shielded.js"
    },
    "./solana/arcium": {
      "types": "./dist/arcium.d.ts",
      "default": "./dist/arcium.js"
    },
    "./solana/noir": {
      "types": "./dist/noir.d.ts",
      "default": "./dist/noir.js"
    },
    "./dist": "./dist/index.js",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json",
    "./package": "./package.json"
  },
  "typesVersions": {
    "*": {
      "box": [
        "dist/nacl-box.d.ts"
      ],
      "shamir": [
        "dist/threshold.d.ts"
      ],
      "payload": [
        "dist/payload.d.ts"
      ],
      "orders": [
        "dist/orders.d.ts"
      ],
      "solana/zk-compression": [
        "dist/zk-compression.d.ts"
      ],
      "solana/rpc-providers": [
        "dist/rpc-providers.d.ts"
      ],
      "solana/shielded": [
        "dist/shielded.d.ts"
      ],
      "solana/arcium": [
        "dist/arcium.d.ts"
      ],
      "solana/noir": [
        "dist/noir.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fabrknt/veil.git",
    "directory": "packages/core"
  },
  "author": "Privacy Suite Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "jest",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/copy-wasm.js || true"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@lightprotocol/stateless.js": "^0.17.0",
    "@lightprotocol/compressed-token": "^0.17.0",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "privacycash": "^1.1.7",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
